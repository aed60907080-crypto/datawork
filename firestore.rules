rules_version = '2';

// قواعد أمان سجل صيانة الأجهزة — المركز الحكومي
// استبدل YOUR-PROJECT.firebaseapp.com بقيمة authDomain لمشروعك قبل النشر.
service cloud.firestore {
  match /databases/{database}/documents {

    function email() {
      return request.auth != null ? request.auth.token.email : '';
    }
    function isGov()   { return email() == 'gov@YOUR-PROJECT.firebaseapp.com'; }
    function isChief() { return email() == 'chief@YOUR-PROJECT.firebaseapp.com'; }
    function isStaff() { return isGov() || isChief(); }

    // قاعدة المركز الحكومي: حساب المركز ورئيس الفريق فقط
    match /sites/GC/{path=**} {
      allow read, write: if isStaff();
    }

    // المشترك: القوائم واسم رئيس الفريق والفنيون
    match /config/{doc} {
      allow read, write: if isStaff();
    }
    match /technicians/{doc} {
      allow read, write: if isStaff();
    }

    // أي مسار آخر مغلق
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
