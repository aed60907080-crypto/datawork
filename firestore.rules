rules_version = '2';

// قواعد أمان سجل صيانة الأجهزة — مشروع datawork-dfa0e
// الأجهزة تتصل بالقاعدة باتصال مجهول (Anonymous)، وكلمات سر الجهات داخل النظام
// محفوظة مُجزَّأة في config/access ويديرها رئيس الفريق.
// تُلصق هذه القواعد في Firestore ← Rules ← Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // بيانات المركز الحكومي
    match /sites/GC/{path=**} {
      allow read, write: if signedIn();
    }

    // القوائم وكلمات السر المُجزَّأة واسم رئيس الفريق
    match /config/{doc} {
      allow read, write: if signedIn();
    }

    // الفنيون
    match /technicians/{doc} {
      allow read, write: if signedIn();
    }

    // أي مسار آخر مغلق
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
